{
  "name": "veyra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "node scripts/lint-no-explicit-any.mjs",
    "test": "vitest run",
    "migrations:check": "node scripts/check-migrations.mjs",
    "migrations:apply": "pnpm --filter @veyra/api migrations:apply",
    "db:seed": "pnpm --filter @veyra/api db:seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm migrations:check && pnpm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
